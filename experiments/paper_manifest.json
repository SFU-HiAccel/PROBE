{
  "schema_version": 1,
  "paper_revision": "67f02b52f416288f9a450aa73ad72b091e25d9de",
  "protocol": {
    "identity": "paper",
    "sampling": {
      "protocol": "paper",
      "backend": "fixed_ce",
      "batch_size": "max(1, floor(0.01*N))",
      "pilot_mode": "uniform",
      "pilot_fraction": 0.3,
      "n_min": 2,
      "p_star": 0.05,
      "delta_sel": 0.05,
      "explore_fraction": 0.25,
      "train_strata": 10,
      "k_max": 6,
      "mu": 1.5
    },
    "representation": {
      "model": "Qwen/Qwen3-VL-Reranker-2B",
      "revision": "4bd860ac4f15ad1897a214615cccc700f8f71818",
      "features": "same-pass last-token hidden state; L2 -> PCA256 for LR; separate L2 for graph"
    },
    "budget": {
      "scope": "preparation",
      "L": "floor(3*B/5)",
      "A": "B-L",
      "D": "uncapped",
      "S3": "uncapped remaining unique IDs"
    },
    "refinement": {
      "lr_C": 1.0,
      "class_weight": "balanced",
      "knn_k": "min(N-1, round(3log2N)); active-body choice",
      "normalization": "row",
      "alpha": 0.8,
      "beta": 0.8,
      "iterations": [
        50,
        50
      ],
      "threshold": 0.5
    },
    "calibration": {
      "input": "refined_score_logit",
      "strata": "up to 10 equal-width refined-score bins, adjacent merges until H<=m",
      "floor_share": 0.2,
      "folds": "min(5,n_pos,n_neg)",
      "model": "shared nonnegative slope, independent A/L intercepts",
      "ridge": "none",
      "targets": "hard A labels, Platt-smoothed L labels using L class counts",
      "anchor": "A-only inverse inclusion weighted",
      "cp_mixture": 0.15,
      "cp_alpha": 0.05,
      "cp_status": "regularization heuristic",
      "loss": "sum_A omega/mean(omega) BCE + sum_L BCE",
      "floor": "max(H, ceil(0.2*m))"
    },
    "routing": {
      "alpha": 0.5,
      "objective": "alpha*(1-estimated F1)+(1-alpha)*delegation",
      "search": "dual prefixes + Dinkelbach"
    },
    "ablation_single_class": "constant",
    "revision": "2026-10-16",
    "lotus": {
      "filter": "Qwen3-VL-2B token log-probability",
      "join": "E5/CLIP left-right cosine similarity",
      "sample_fraction": 0.1,
      "failure_probability": 0.1
    }
  },
